{
  "name": "@brilliantmode/ui",
  "version": "0.2.0",
  "description": "Protected, upgradeable React components for Brilliant UI",
  "license": "MIT",
  "homepage": "https://brilliant-ui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brilliantmode/brilliant-ui.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/brilliantmode/brilliant-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwindcss",
    "shadcn",
    "design-system"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "brilliant-ui-mcp": "dist/mcp/bin.js"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./animations": {
      "types": "./dist/animations.d.ts",
      "import": "./dist/animations.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    },
    "./*": {
      "types": "./dist/generated/*.d.ts",
      "import": "./dist/generated/*.js"
    }
  },
  "scripts": {
    "generate": "tsx scripts/generate-components.ts",
    "prepack": "pnpm build",
    "build": "pnpm generate && tsx scripts/clean-dist.ts && tsc -p tsconfig.build.json",
    "lint": "pnpm generate && biome check src scripts",
    "test": "pnpm build && vitest run && pnpm test:mcp-package",
    "test:mcp-package": "tsx scripts/smoke-mcp-package.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-is": "^19.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.5.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0"
  }
}
