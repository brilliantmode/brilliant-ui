{
  "name": "@brilliantmode/ui",
  "version": "0.1.0",
  "description": "Protected, upgradeable React components for Brilliant UI",
  "license": "MIT",
  "homepage": "https://brilliant-ui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brilliantmode/brilliant-ui.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/brilliantmode/brilliant-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwindcss",
    "shadcn",
    "design-system"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "brilliant-ui-mcp": "dist/mcp/bin.js"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./animations": {
      "types": "./dist/animations.d.ts",
      "import": "./dist/animations.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    },
    "./*": {
      "types": "./dist/generated/*.d.ts",
      "import": "./dist/generated/*.js"
    }
  },
  "scripts": {
    "generate": "tsx scripts/generate-components.ts",
    "prepack": "pnpm build",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "lint": "pnpm generate && biome check src scripts",
    "test": "pnpm build && vitest run && pnpm test:mcp-package",
    "test:mcp-package": "tsx scripts/smoke-mcp-package.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-scroll-area": "catalog:",
    "@radix-ui/react-select": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "react-is": "catalog:",
    "recharts": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.1.0"
  }
}
